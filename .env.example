# ─── Site ───────────────────────────────────────────────────────────────────
SITE_URL=https://maisoncbdvape.fr

# ─── Monetico Paiement (Crédit Mutuel) ──────────────────────────────────────
# Fournis par la banque à l'ouverture du contrat Monetico Paiement.
MONETICO_ENV=test               # "test" (sandbox) ou "production"
MONETICO_TPE=                   # n° de TPE virtuel — 7 caractères alphanumériques
MONETICO_SOCIETE=               # code société
MONETICO_CLE_MAC=               # clé de sécurité — 40 caractères hexadécimaux ⚠ SECRET

# ─── Emails transactionnels (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=MaisonCBDVape <noreply@maisoncbdvape.fr>
EMAIL_REPLY_TO=contact@maisoncbdvape.fr
EMAIL_MERCHANT=contact@maisoncbdvape.fr

# ─── Back-office (Decap CMS via GitHub OAuth) ───────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_REPO=FlowPesci/maisoncbdvape
ADMIN_GITHUB_USERS=FlowPesci
