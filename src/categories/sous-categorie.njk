---
layout: layouts/base.njk
pagination:
  data: sousCategories
  size: 1
  alias: sous
permalink: "/categories/{{ sous.categorieSlug }}/{{ sous.slug }}/index.html"
eleventyComputed:
  title: "{{ sous.nom }}"
  description: "{{ sous.nom }} — {{ sous.categorieNom }} chez MaisonCBDVape à Gex (01170). Retrait en boutique en 1 heure ou livraison."
---

{% from "components/product-card.njk" import productCard %}

{% set produitsSous = produits | where("categorie", sous.categorieSlug) | where("sousCategorie", sous.slug) %}
{% set nbProduits = produitsSous | count %}

{# ═══════════════════════════════════════════════════════════════════════
   EN-TÊTE
   ═══════════════════════════════════════════════════════════════════════ #}
<div style="padding:100px 0 0;border-bottom:1px solid var(--borderl);">
  <div class="section-pad section-header-flex" style="max-width:1280px;margin:0 auto;padding:0 40px 32px;display:flex;align-items:flex-end;justify-content:space-between;gap:24px;">

    <div>
      {# Fil d'Ariane — la sous-catégorie remonte à sa catégorie #}
      <nav aria-label="Fil d'Ariane" style="display:flex;align-items:center;gap:8px;margin-bottom:20px;font-size:11px;letter-spacing:.12em;flex-wrap:wrap;">
        <a href="/" style="color:var(--muted);text-decoration:none;transition:color .3s;" data-hover="gold">Accueil</a>
        <svg style="width:10px;height:10px;color:var(--borderl);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        <a href="/categories/{{ sous.categorieSlug }}/" style="color:var(--muted);text-decoration:none;transition:color .3s;" data-hover="gold">{{ sous.categorieNomCourt }}</a>
        <svg style="width:10px;height:10px;color:var(--borderl);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        <span style="color:var(--gold);">{{ sous.nom }}</span>
      </nav>

      <div style="display:flex;align-items:center;gap:12px;font-size:10px;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;">
        <div style="width:24px;height:1px;background:var(--gold);opacity:.6;"></div>
        {{ sous.categorieNomCourt }}
      </div>

      <h1 style="font-family:var(--font-titre);font-size:clamp(44px,7vw,88px);font-weight:300;line-height:.95;color:var(--cream);letter-spacing:-.01em;">
        <em style="font-style:normal;color:var(--gold);">{{ sous.nom }}</em>
      </h1>
    </div>

    {% if nbProduits > 0 %}
      <div style="display:flex;gap:32px;align-items:center;flex-shrink:0;padding-bottom:8px;">
        <div style="text-align:right;">
          <div style="font-family:var(--font-titre);font-size:2.4rem;font-weight:300;color:var(--gold-light);">{{ nbProduits }}</div>
          <div style="font-size:9px;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);">Produit{% if nbProduits > 1 %}s{% endif %}</div>
        </div>
      </div>
    {% endif %}

  </div>
</div>

{# ═══════════════════════════════════════════════════════════════════════
   NAVIGATION ENTRE SOUS-CATÉGORIES SŒURS
   ═══════════════════════════════════════════════════════════════════════ #}
<div style="border-bottom:1px solid var(--borderl);background:var(--dark2);">
  <div class="rail-onglets" style="max-width:1280px;margin:0 auto;padding:0 40px;display:flex;gap:8px;">
    <a href="/categories/{{ sous.categorieSlug }}/"
       style="padding:16px 18px;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);text-decoration:none;white-space:nowrap;border-bottom:2px solid transparent;transition:color .25s;"
       data-hover="gold">Tout voir</a>
    {% for s in sousCategories %}{% if s.categorieSlug == sous.categorieSlug %}
      <a href="{{ s.url }}"
         style="padding:16px 18px;font-size:10px;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transition:color .25s;{% if s.slug == sous.slug %}color:var(--gold);border-bottom:2px solid var(--gold);{% else %}color:var(--muted);border-bottom:2px solid transparent;{% endif %}"
         {% if s.slug != sous.slug %}data-hover="gold"{% endif %}>{{ s.nom }}</a>
    {% endif %}{% endfor %}
  </div>
</div>

{# ═══════════════════════════════════════════════════════════════════════
   PRODUITS
   ═══════════════════════════════════════════════════════════════════════ #}
<section style="padding:48px 0 96px;background:var(--dark);">
  <div style="max-width:1280px;margin:0 auto;padding:0 40px;">
    {% if nbProduits > 0 %}
      <div class="grid-products-3col" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;">
        {% for p in produitsSous %}{{ productCard(p) }}{% endfor %}
      </div>
    {% else %}
      <div style="text-align:center;padding:80px 20px;border:1px dashed var(--borderl);background:rgba(201,169,110,.03);">
        <p style="font-family:var(--font-titre);font-size:1.5rem;font-weight:300;color:var(--cream);margin-bottom:.75rem;">Aucun produit pour le moment</p>
        <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;">Cette sélection sera bientôt enrichie.</p>
        <a href="/categories/{{ sous.categorieSlug }}/" class="btn-gold inline-flex items-center gap-2 px-6 py-3 text-sm uppercase tracking-widest">
          Voir tout {{ sous.categorieNomCourt }}
        </a>
      </div>
    {% endif %}
  </div>
</section>
