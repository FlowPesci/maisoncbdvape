{%- set trace = traces[nom] -%}
{%- if trace -%}
<svg class="icone {{ classe }}" style="color:{{ couleur }};" fill="none" viewBox="0 0 24 24"
     stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
  {%- for d in trace.split(" M") -%}
  <path stroke-linecap="round" stroke-linejoin="round" d="{% if not loop.first %}M{% endif %}{{ d }}"/>
  {%- endfor -%}
</svg>
{%- endif -%}
