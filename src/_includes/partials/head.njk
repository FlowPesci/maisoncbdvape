{# ──────────────────────────────────────────────────────────────────────────
   head.njk — bloc <head> commun à toutes les pages — MaisonCBDVape
────────────────────────────────────────────────────────────────────────── #}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{# ⚠ La marque n'apparaît QU'UNE FOIS. L'audit du 2026-09-30 a relevé sur
   l'accueil : « MaisonCBDVape – L'art de savourer autrement – MaisonCBDVape |
   L'art de savourer autrement ». La cause n'était pas ici mais dans le front
   matter d'`index.njk`, qui portait déjà le nom ET la baseline, auxquels cette
   ligne ajoutait les deux mêmes.

   La règle : le front matter décrit LA PAGE, jamais la marque. Le suffixe est
   ajouté ici, et ici seulement. La baseline ne sert plus qu'aux pages sans
   titre propre — il n'en reste aucune, mais le repli évite un titre vide. #}
<title>{{ title | titrePage(site.nom, site.tagline) }}</title>
<meta name="description" content="{{ description or site.description }}" />

{# ─── Open Graph / Twitter ─────────────────────────────────────────── #}
<meta property="og:type"        content="website" />
<meta property="og:locale"      content="{{ site.locale }}" />
<meta property="og:site_name"   content="{{ site.nom }}" />
<meta property="og:title"       content="{{ title | titrePage(site.nom, site.tagline) }}" />
<meta property="og:description" content="{{ description or site.description }}" />
<meta property="og:url"         content="{{ site.url }}{{ canonicalPath or page.url }}" />

{# ⚠ `og:image` n'est JAMAIS conditionnelle. Elle l'était, et comme aucune page
   hors fiche produit ne définissait `ogImage`, l'accueil partait sans visuel —
   relevé par l'audit du 2026-09-30. Le pire était l'incohérence : la ligne
   `twitter:card` annonçait `summary_large_image`, donc une grande image, à une
   plateforme qui n'en recevait aucune. Un lien partagé sortait en carte grise.

   Le repli est `scripts/generer-og-image.mjs`, dessiné depuis les tokens et
   `site.json`. Les fiches produits continuent de passer leur propre photo.
   L'URL doit être ABSOLUE : les plateformes ne résolvent pas un chemin
   relatif, elles ne visitent pas la page. #}
{% set partage = ogImage or (site.url + '/assets/img/og-maisoncbdvape.png') %}
<meta property="og:image"     content="{{ partage }}" />
<meta property="og:image:alt" content="{{ ogImageAlt or (site.nom + ' — ' + site.tagline) }}" />
{# Les dimensions ne sont annoncées que pour le visuel de repli, dont on les
   connaît. Les déclarer sur une photo produit — dont la taille varie d'une
   fiche à l'autre — reviendrait à annoncer 1200 × 630 pour une image qui n'en
   fait pas : une plateforme qui réserve la place d'après ces valeurs afficherait
   un cadre de travers. Mieux vaut qu'elle mesure elle-même. #}
{% if not ogImage %}<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />{% endif %}
<meta name="twitter:card"  content="summary_large_image" />
<meta name="twitter:image" content="{{ partage }}" />

<link rel="canonical" href="{{ site.url }}{{ canonicalPath or page.url }}" />

{# ─── Tailwind CSS ────────────────────────────────────────────────────── #}
<link rel="stylesheet" href="/assets/css/tailwind.css?v={{ '/assets/css/tailwind.css' | contentHash }}">

{# ─── Polices (Bitter + DM Sans + Space Mono) ──────────────────────────
   Auto-hébergées dans src/assets/fonts/, déclarées dans tailwind/input.css.
   Plus d'appel à Google : rien à preconnecter. Seuls les deux graisses du
   premier rendu (titre en Bitter 300, corps en DM Sans 300 — poids par
   défaut de `body`) valent la peine d'être préchargées ; le reste attend
   d'être découvert par la CSS comme n'importe quelle police. #}
<link rel="preload" href="/assets/fonts/bitter-300-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/dm-sans-300-latin.woff2" as="font" type="font/woff2" crossorigin>

{# ─── Icônes ───────────────────────────────────────────────────────────
   Le SVG couvre les navigateurs modernes et reste net à toutes les tailles.
   Les PNG servent aux plateformes qui ne lisent pas le SVG : iOS pour
   l'écran d'accueil, Android pour l'installation depuis le manifeste. #}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#1A1714" />

{# ─── JSON-LD structuré ───────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Store",
  "name": "{{ site.nom }}",
  {# ⚠ L'enseigne et le site n'ont pas le même nom : la devanture et la fiche
     Google disent « Tabac PRESSE - CBD - VAPE - CHICHA », le site dit
     « MaisonCBDVape ». Ce n'est pas une incohérence à corriger — Google exige
     que le nom d'une fiche soit celui de la devanture, et cette fiche porte
     141 avis qu'on ne risque pas pour une question de cohérence de marque.
     On déclare les deux : l'adresse et le téléphone, identiques des deux
     côtés, font le rapprochement ; `alternateName` lève le doute restant. #}
  "alternateName": "{{ site.etablissement.nomEnseigne }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.contact.telephoneE164 }}",
  "image": "{{ site.url }}/assets/img/og-maisoncbdvape.png",
  "priceRange": "{{ site.etablissement.gammePrix }}",
  "sameAs": [
    "{{ site.etablissement.ficheGoogle }}",
    "{{ site.social.instagram }}",
    "{{ site.social.facebook }}"
  ],
  {# La zone réellement desservie par le retrait en boutique. Gex est à vingt
     minutes de Genève, et la clientèle vient de tout le Pays de Gex — le
     déclarer aide Google à rattacher la boutique à ces recherches. On ne
     déclare que des communes d'où l'on vient vraiment ; une liste gonflée
     n'apporte rien et finit par ressembler à ce qu'elle est. #}
  "areaServed": [
    { "@type": "City", "name": "Gex" },
    { "@type": "City", "name": "Cessy" },
    { "@type": "City", "name": "Ferney-Voltaire" },
    { "@type": "City", "name": "Saint-Genis-Pouilly" },
    { "@type": "City", "name": "Divonne-les-Bains" },
    { "@type": "AdministrativeArea", "name": "Pays de Gex" }
  ],
  {# ⚠ Généré depuis `horairesRetrait`, la table que le serveur interroge pour
     accepter un créneau de retrait — pas depuis une phrase. Voir
     `src/_data/ouverture.js` : annoncer à Google un horaire que le tunnel de
     commande contredit est la pire des deux erreurs possibles. #}
  "openingHoursSpecification": {{ ouverture.jsonld | dump | safe }},
  {# ⚠ Ces coordonnées ne sont pas estimées : ce sont celles du point de la
     fiche Google elle-même, relevées dans l'URL de sa page Maps. Google
     géocode de toute façon l'adresse, mais Bing, Apple et les annuaires ne le
     font pas tous aussi bien. **Ne jamais les deviner** : une latitude
     inventée place la boutique dans un champ, et c'est une mention fausse
     produite par nous. Si le commerçant déplace le point de sa fiche, ces
     deux nombres doivent suivre. #}
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ site.etablissement.latitude }},
    "longitude": {{ site.etablissement.longitude }}
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.adresse.rue }}",
    "postalCode": "{{ site.adresse.codePostal }}",
    "addressLocality": "{{ site.adresse.ville }}",
    "addressCountry": "FR"
  }
}
</script>
