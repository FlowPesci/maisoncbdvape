{# ──────────────────────────────────────────────────────────────────────────
   header.njk — Navigation luxury MaisonCBDVape
────────────────────────────────────────────────────────────────────────── #}
<header class="mcv-header fixed top-0 left-0 right-0 z-50">
  <div class="header-inner" style="max-width:1280px;margin:0 auto;">
    <div style="display:flex;align-items:center;justify-content:space-between;height:72px;">

      {# ─── Logo ───────────────────────────────────────────────────── #}
      <a href="/" style="text-decoration:none;flex-shrink:0;" aria-label="MaisonCBDVape – Accueil">
        <span style="font-family:var(--font-titre);font-size:1.2rem;font-weight:300;letter-spacing:0.18em;text-transform:uppercase;line-height:1;">
          <span style="color:#F5F0E8;">MAISON</span><span style="color:#C9A96E;">CBD</span><span style="color:#F5F0E8;">VAPE</span>
        </span>
      </a>

      {# ─── Nav desktop ─────────────────────────────────────────────── #}
      <nav class="hidden lg:flex" style="align-items:center;gap:36px;" aria-label="Navigation principale">
        {# Dérivée de categories.json : retirer une catégorie la retire du menu.
           Chaque entrée ouvre un panneau de sous-catégories au survol. #}
        {% for cat in categories %}
          {% set url = "/categories/" + cat.slug + "/" %}
          <div class="nav-item" data-cat="{{ cat.slug }}">
            <a href="{{ url }}" class="nav-link {% if page.url == url %}is-active{% endif %}">
              {{ cat.nomCourt or cat.nom }}
            </a>
          </div>
        {% endfor %}
      </nav>

      {# ─── Icônes droite ───────────────────────────────────────────── #}
      <div class="header-icons" style="display:flex;align-items:center;gap:20px;">

        {# ─── Icônes dessinées à la main, trait 1.1 ─────────────────────
           Les icônes de bibliothèque (caddie à roulettes, buste plein, trait
           1.6) pesaient trois fois plus que le logotype en Cormorant 300 et
           donnaient un air de place de marché. Le référent du commerce de
           détail soigné, c'est le sac cabas, pas le chariot de supermarché.
           Ne pas remonter l'épaisseur du trait : c'est elle qui fait le ton. #}

        {# Recherche — cercle et manche, sans fioriture #}
        <a href="/recherche/" class="icon-btn" aria-label="Rechercher">
          <svg style="width:19px;height:19px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
            <circle cx="10.5" cy="10.5" r="7"/>
            <path d="M15.6 15.6L21 21"/>
          </svg>
        </a>

        {# Compte — buste ouvert : un arc, pas une silhouette fermée #}
        <a href="/compte/" class="icon-btn" aria-label="Mon compte">
          <svg style="width:19px;height:19px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
            <circle cx="12" cy="8" r="3.6"/>
            <path d="M5.6 20.5a6.4 6.4 0 0 1 12.8 0"/>
          </svg>
        </a>

        {# Panier — sac cabas à anses #}
        <a href="/panier/" class="icon-btn" style="position:relative;" aria-label="Mon panier">
          <svg style="width:19px;height:19px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.4 7.8h13.2l1.1 13.2H4.3z"/>
            <path d="M9 7.8V6a3 3 0 0 1 6 0v1.8"/>
          </svg>
          <span id="cart-badge" class="cart-badge" style="display:none;">0</span>
        </a>

        {# ─── Burger mobile ─────────────────────────────────────────────
           Deux barres de longueurs inégales plutôt que les trois barres
           égales de l'icône générique. Les états (survol, ouvert en croix)
           sont pilotés en CSS depuis `aria-expanded`, que le JS bascule
           déjà : aucune classe supplémentaire à gérer côté script. #}
        <button id="menu-toggle" class="lg:hidden icon-btn menu-burger" aria-label="Ouvrir le menu" aria-expanded="false">
          <span class="menu-burger-barre"></span>
          <span class="menu-burger-barre"></span>
        </button>
      </div>

    </div>
  </div>

  {# ─── Méga-menu : un panneau par catégorie, pleine largeur ─────────────
       Placé hors du conteneur de la nav pour pouvoir s'étendre sur toute la
       largeur de l'écran. Affiché au survol de l'entrée correspondante et
       maintenu ouvert tant que le pointeur reste dans le panneau. #}
  {% for cat in categories %}
    {% if cat.sousCategories %}
      <div class="mega-panel" data-panel="{{ cat.slug }}" aria-hidden="true">
        <div style="max-width:1280px;margin:0 auto;padding:28px 40px 32px;">
          <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--borderl);">
            <span style="font-family:var(--font-titre);font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);">{{ cat.nom }}</span>
            <a href="/categories/{{ cat.slug }}/" style="font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color .25s;"
               data-hover="gold">Tout voir →</a>
          </div>
          <div class="mega-grid">
            {% for s in cat.sousCategories %}
              {% set n = produits | where("categorie", cat.slug) | where("sousCategorie", s.slug) | count %}
              <a href="/categories/{{ cat.slug }}/{{ s.slug }}/" class="mega-link">
                <span class="mega-link-nom">{{ s.nom }}</span>
                <span class="mega-link-nb">{{ n }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {# ─── Menu mobile ─────────────────────────────────────────────────── #}
  <div id="mobile-menu" class="hidden lg:hidden" style="border-top:1px solid var(--borderl);background:rgba(26,23,20,0.98);">
    <div style="padding:24px 40px 32px;display:flex;flex-direction:column;gap:4px;">
      {% for cat in categories %}
        <div style="border-bottom:1px solid var(--borderl);">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <a href="/categories/{{ cat.slug }}/"
               style="display:block;padding:10px 0;font-family:var(--font-titre);font-size:1.6rem;font-weight:300;letter-spacing:.06em;text-transform:uppercase;color:var(--text);text-decoration:none;transition:color .3s;flex:1;"
               data-hover="gold">
              {{ cat.nomCourt or cat.nom }}
            </a>
            {% if cat.sousCategories %}
              <button type="button" class="mobile-sub-toggle" data-cat="{{ cat.slug }}" aria-expanded="false"
                      aria-label="Afficher les sous-catégories de {{ cat.nomCourt or cat.nom }}"
                      style="background:none;border:none;padding:10px 4px 10px 16px;cursor:pointer;color:var(--muted);">
                <svg style="width:16px;height:16px;transition:transform .25s;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
              </button>
            {% endif %}
          </div>
          {% if cat.sousCategories %}
            <div class="mobile-sub hidden" data-sub="{{ cat.slug }}" style="padding:0 0 12px 14px;">
              {% for s in cat.sousCategories %}
                <a href="/categories/{{ cat.slug }}/{{ s.slug }}/"
                   style="display:block;padding:7px 0;font-size:12.5px;letter-spacing:.08em;color:var(--muted);text-decoration:none;transition:color .25s;"
                   data-hover="gold">{{ s.nom }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
      <a href="/recherche/"
         style="display:block;padding:10px 0;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--muted);text-decoration:none;margin-top:8px;">
        Rechercher
      </a>
      <a href="/compte/"
         style="display:block;padding:10px 0;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--muted);text-decoration:none;">
        Mon compte
      </a>
    </div>
  </div>
</header>

{# ─── Comportement du méga-menu ───────────────────────────────────────── #}
<script src="/assets/js/header.js?v={{ '/assets/js/header.js' | contentHash }}" defer></script>

