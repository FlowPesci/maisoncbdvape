---
layout: layouts/base.njk
permalink: /commande/index.html
title: "Finaliser ma commande"
description: "Coordonnées et mode de livraison — MaisonCBDVape, boutique CBD & Vape à Gex (01170)"
---
{# ──────────────────────────────────────────────────────────────────────────
   commande.njk — Formulaire de commande — MaisonCBDVape gold luxury
   ────────────────────────────────────────────────────────────────────────── #}

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">

  {# Fil d'Ariane #}
  <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 mb-6 text-xs fade-up" style="font-family:'DM Sans',sans-serif;">
    <a href="/" style="color:var(--muted);transition:color .2s;" onmouseover="this.style.color='var(--cream)'" onmouseout="this.style.color='var(--muted)'">Accueil</a>
    <svg class="w-3 h-3" style="color:var(--borderl);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <a href="/panier/" style="color:var(--muted);transition:color .2s;" onmouseover="this.style.color='var(--cream)'" onmouseout="this.style.color='var(--muted)'">Mon panier</a>
    <svg class="w-3 h-3" style="color:var(--borderl);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    <span style="color:var(--gold);">Finaliser</span>
  </nav>

  <h1 class="fade-up" style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,5vw,3.5rem);font-weight:300;color:var(--cream);letter-spacing:.04em;line-height:1.05;margin-bottom:.5rem;">
    Finaliser ma <em style="font-style:normal;color:var(--gold-light);">commande</em>
  </h1>
  <p class="fade-up" style="color:var(--muted);font-size:.875rem;margin-bottom:2.5rem;">Vos coordonnées et votre mode de réception.</p>

  {# ── Sélecteur de mode — généré depuis src/_data/site.json ──
       Les modes dont "actif" vaut false sont rendus mais masqués. Ils
       n'apparaissent qu'avec ?apercu=1, pour permettre de recetter un mode
       avant de l'ouvrir à la vente. Le serveur les refuse de toute façon :
       aucune commande ne peut être passée depuis un aperçu. #}
  <div class="grid grid-cols-2 gap-3 mb-10 fade-up" id="mode-selector">
    {% for id, m in site.livraison.modes %}
      <button type="button" class="mode-btn{% if not m.actif %} mode-apercu hidden{% endif %}"
              data-mode="{{ id }}" data-saisie="{{ m.saisie }}" data-actif="{{ 'true' if m.actif else 'false' }}"
              style="border-radius:2px;border:1px solid var(--borderl);background:transparent;padding:1rem;text-align:left;transition:border-color .25s,background .25s;cursor:pointer;">
        <div class="flex items-center gap-3" style="margin-bottom:.5rem;">
          <span class="mode-icon" style="width:32px;height:32px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:rgba(201,169,110,0.08);flex-shrink:0;">
            <svg style="width:16px;height:16px;color:var(--muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              {%- if m.saisie == "creneau" -%}
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              {%- elif m.saisie == "point" -%}
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
              {%- else -%}
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
              {%- endif -%}
            </svg>
          </span>
          <span class="mode-label" style="font-family:'DM Sans',sans-serif;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--cream);">{{ m.libelle }}{% if not m.actif %} <span style="color:#FF8080;font-size:.6rem;">· aperçu</span>{% endif %}</span>
        </div>
        <p style="font-size:.75rem;color:var(--muted);font-family:'DM Sans',sans-serif;">
          {%- if m.fraisPort > 0 -%}
            {{ m.transporteur }} — Offerte dès {{ m.seuilGratuit | eur }}, sinon {{ m.fraisPort | eur }}
          {%- else -%}
            {{ m.accroche }}
          {%- endif -%}
        </p>
      </button>
    {% endfor %}
  </div>

  {# Empty state si panier vide #}
  <div id="checkout-empty" class="hidden text-center py-20" style="border:1px dashed var(--borderl);background:rgba(201,169,110,.03);border-radius:2px;">
    <div class="text-5xl mb-4">🛒</div>
    <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.75rem;font-weight:300;color:var(--cream);margin-bottom:.5rem;">Panier vide</h3>
    <p style="color:var(--muted);font-size:.875rem;max-width:26rem;margin:0 auto 1.5rem;">Ajoutez d'abord des produits avant de passer commande.</p>
    <a href="/" class="btn-gold inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold uppercase tracking-widest">Découvrir la boutique</a>
  </div>

  <form id="checkout-form" class="hidden grid lg:grid-cols-3 gap-8" novalidate>

    {# Champ caché : mode choisi #}
    {# Volontairement sans valeur : le script du sélecteur la renseigne au
       chargement, à partir du PREMIER mode actif de site.json. Y écrire un
       mode en dur créerait un second endroit à corriger le jour où l'ordre
       change — c'est exactement ce qui a fait diverger les frais de port et
       les créneaux par le passé. Sans JavaScript, le serveur refuse la
       commande avec un message explicite plutôt que d'appliquer un mode
       que le client n'a pas choisi. #}
    <input type="hidden" name="modeLivraison" id="mode-livraison-hidden" value=""/>

    {# Colonne gauche : formulaire #}
    <div class="lg:col-span-2 space-y-6">

      {# ─── Coordonnées ─── #}
      <div style="border-radius:2px;background:var(--dark2);border:1px solid var(--borderl);padding:1.5rem;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;letter-spacing:.12em;color:var(--cream);margin-bottom:1.25rem;font-weight:400;">VOS COORDONNÉES</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block sm:col-span-2">
            <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Nom complet *</span>
            <input type="text" name="nom" required minlength="2" maxlength="80" placeholder="Jean Dupont"
                   style="width:100%;background:var(--dark);border:1px solid var(--borderl);border-radius:2px;padding:.75rem 1rem;color:var(--cream);font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;"
                   onfocus="this.style.borderColor='rgba(201,169,110,0.5)'" onblur="this.style.borderColor='var(--borderl)'"/>
            <span class="error-msg hidden mt-1 text-xs text-red-400" data-error-for="nom"></span>
          </label>
          <label class="block">
            <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Email *</span>
            <input type="email" name="email" required maxlength="120" placeholder="vous@exemple.com"
                   style="width:100%;background:var(--dark);border:1px solid var(--borderl);border-radius:2px;padding:.75rem 1rem;color:var(--cream);font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;"
                   onfocus="this.style.borderColor='rgba(201,169,110,0.5)'" onblur="this.style.borderColor='var(--borderl)'"/>
            <span class="error-msg hidden mt-1 text-xs text-red-400" data-error-for="email"></span>
          </label>
          <label class="block">
            <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Téléphone *</span>
            <input type="tel" name="telephone" required pattern="[0-9 +.\-()]{8,}" maxlength="20" placeholder="06 12 34 56 78"
                   style="width:100%;background:var(--dark);border:1px solid var(--borderl);border-radius:2px;padding:.75rem 1rem;color:var(--cream);font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;"
                   onfocus="this.style.borderColor='rgba(201,169,110,0.5)'" onblur="this.style.borderColor='var(--borderl)'"/>
            <span class="error-msg hidden mt-1 text-xs text-red-400" data-error-for="telephone"></span>
          </label>
          <label class="block sm:col-span-2">
            <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Notes (optionnel)</span>
            <textarea name="notes" rows="2" maxlength="300" placeholder="Indication particulière (allergies, préférence…)"
                      style="width:100%;background:var(--dark);border:1px solid var(--borderl);border-radius:2px;padding:.75rem 1rem;color:var(--cream);font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;resize:none;"
                      onfocus="this.style.borderColor='rgba(201,169,110,0.5)'" onblur="this.style.borderColor='var(--borderl)'"></textarea>
          </label>
        </div>
      </div>

      {# ─── Créneau retrait (Click & Collect) ─── #}
      <div id="section-cc" style="border-radius:2px;background:var(--dark2);border:1px solid var(--borderl);padding:1.5rem;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;letter-spacing:.12em;color:var(--cream);margin-bottom:.5rem;font-weight:400;">CRÉNEAU DE RETRAIT</h2>
        <p style="font-size:.75rem;color:var(--muted);margin-bottom:1.25rem;font-family:'DM Sans',sans-serif;line-height:1.6;">
          📍 {{ site.adresse.rue }}, {{ site.adresse.codePostal }} {{ site.adresse.ville }}<br/>
          <strong style="color:var(--cream);">Votre commande est prête en 1 heure.</strong> Choisissez un créneau à partir de maintenant, aujourd'hui compris.
        </p>

        <input type="hidden" name="creneauDate" id="creneauDate-hidden"/>
        <span class="error-msg hidden mt-1 text-xs text-red-400" data-error-for="creneauDate"></span>

        <div class="mb-5">
          <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.75rem;font-family:'DM Sans',sans-serif;">Date *</span>
          <div class="flex items-center justify-between mb-3">
            <button type="button" id="cal-prev" aria-label="Mois précédent"
                    style="width:32px;height:32px;border-radius:4px;border:1px solid var(--borderl);background:var(--dark);color:var(--muted);display:flex;align-items:center;justify-content:center;transition:border-color .2s,color .2s;"
                    onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--gold)'"
                    onmouseout="this.style.borderColor='var(--borderl)';this.style.color='var(--muted)'">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
            </button>
            <span id="cal-title" style="color:var(--cream);font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:500;text-transform:capitalize;"></span>
            <button type="button" id="cal-next" aria-label="Mois suivant"
                    style="width:32px;height:32px;border-radius:4px;border:1px solid var(--borderl);background:var(--dark);color:var(--muted);display:flex;align-items:center;justify-content:center;transition:border-color .2s,color .2s;"
                    onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--gold)'"
                    onmouseout="this.style.borderColor='var(--borderl)';this.style.color='var(--muted)'">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
            </button>
          </div>
          <div class="grid grid-cols-7 mb-1">
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Lu</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Ma</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Me</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Je</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Ve</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Sa</span>
            <span style="text-align:center;font-size:.7rem;font-family:'Space Mono',monospace;color:var(--muted);padding:.25rem 0;">Di</span>
          </div>
          <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>
          <p id="cal-selected-label" class="hidden" style="margin-top:.75rem;font-size:.75rem;color:var(--muted);font-family:'DM Sans',sans-serif;">
            ✓ <span id="cal-selected-text" style="color:var(--gold);font-weight:600;"></span>
          </p>
        </div>

        <label class="block">
          <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Heure approximative *</span>
          <select name="creneauHeure" id="creneauHeure-select"
                  style="width:100%;background:var(--dark);border:1px solid var(--borderl);border-radius:2px;padding:.75rem 1rem;color:var(--cream);font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;appearance:auto;transition:border-color .2s;"
                  onfocus="this.style.borderColor='rgba(201,169,110,0.5)'" onblur="this.style.borderColor='var(--borderl)'">
            <option value="" style="background:#161410;color:#D8D0C4;">— Choisir une date d'abord —</option>
          </select>
          <span class="error-msg hidden mt-1 text-xs text-red-400" data-error-for="creneauHeure"></span>
        </label>
      </div>

      {# ── Données du calendrier ──
           Embarquées ici plutôt que lues depuis un objet global défini
           ailleurs dans le layout : le script ci-dessous s'exécute pendant
           l'analyse du document, et toute donnée déclarée après lui serait
           invisible. Un calendrier sans créneaux grise toutes les dates sans
           le moindre message — panne silencieuse, très coûteuse à diagnostiquer. #}
      <script id="creneaux-data" type="application/json">
        {
          "creneaux": {{ creneaux | dump | safe }},
          "delaiPreparationMinutes": {{ site.livraison.modes["click-and-collect"].delaiPreparationMinutes or 60 }}
        }
      </script>

      {# ── Script calendrier ── #}
      <script>
      (function () {
        const hiddenDate  = document.getElementById('creneauDate-hidden');
        const calGrid     = document.getElementById('cal-grid');
        const calTitle    = document.getElementById('cal-title');
        const calPrev     = document.getElementById('cal-prev');
        const calNext     = document.getElementById('cal-next');
        const calLabel    = document.getElementById('cal-selected-label');
        const calText     = document.getElementById('cal-selected-text');
        const heureSelect = document.getElementById('creneauHeure-select');
        // Créneaux dérivés des horaires d'ouverture au moment du build, et
        // délai de préparation — même source que la validation serveur.
        let CRENEAUX = {}, DELAI_MIN = 60;
        try {
          const brut = JSON.parse(document.getElementById('creneaux-data').textContent);
          CRENEAUX  = brut.creneaux || {};
          DELAI_MIN = brut.delaiPreparationMinutes ?? 60;
        } catch (e) {
          console.error('[calendrier] Données de créneaux illisibles', e);
        }

        // Sans créneaux, toutes les dates seraient grisées sans explication.
        // On le dit franchement plutôt que de laisser le client bloqué.
        if (!Object.keys(CRENEAUX).length) {
          console.error('[calendrier] Aucun créneau reçu — vérifier src/_data/creneaux.js et relancer npm run build');
          const zone = document.getElementById('cal-grid');
          if (zone) {
            zone.innerHTML = '<p style="grid-column:1/-1;padding:20px 0;font-size:.8rem;color:#FF8080;line-height:1.6;">' +
              'Les créneaux de retrait n\'ont pas pu être chargés.<br/>' +
              'Choisissez la livraison à domicile, ou contactez-nous au ' +
              {{ site.contact.telephone | dump | safe }} + '.</p>';
          }
          return;
        }

        const today = new Date(); today.setHours(0,0,0,0);
        // Le retrait le jour même est possible : la date minimale est aujourd'hui.
        const minDate = new Date(today);
        let viewYear = minDate.getFullYear(), viewMonth = minDate.getMonth(), selectedDate = null;

        /** Créneaux encore réservables pour une date donnée. */
        function slotsDisponibles(date) {
          const slots = CRENEAUX[String(date.getDay())] || [];
          const now = new Date();
          if (date.toDateString() !== now.toDateString()) return slots;
          // Jour même : on ne garde que ce qui laisse le temps de préparer
          const limite = now.getHours() * 60 + now.getMinutes() + DELAI_MIN;
          return slots.filter(sl => {
            const [h, m] = sl.value.split(':').map(Number);
            return h * 60 + m >= limite;
          });
        }
        function isoStr(d) { return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
        function frStr(d) { return d.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' }); }
        function renderHeure(dow, forDate) {
          const slots = slotsDisponibles(forDate);
          const bg = '#161410', fg = '#D8D0C4';
          heureSelect.innerHTML = `<option value="" style="background:${bg};color:${fg};">— Choisir —</option>` +
            slots.map(s => `<option value="${s.value}" style="background:${bg};color:${fg};">${s.label}</option>`).join('');
          heureSelect.disabled = slots.length === 0;
          if (slots.length === 0) heureSelect.innerHTML = `<option value="" style="background:${bg};color:${fg};">Aucun créneau disponible</option>`;
        }
        function renderCalendar() {
          calTitle.textContent = new Date(viewYear, viewMonth, 1).toLocaleDateString('fr-FR', { month:'long', year:'numeric' });
          const startDow = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
          const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
          let html = '';
          for (let i = 0; i < startDow; i++) html += '<span></span>';
          for (let d = 1; d <= daysInMonth; d++) {
            const date = new Date(viewYear, viewMonth, d);
            const iso = isoStr(date);
            const isDisabled = date < minDate || slotsDisponibles(date).length === 0;
            const isSelected = selectedDate && isoStr(selectedDate) === iso;
            let style, cls = 'w-full aspect-square text-xs font-mono flex items-center justify-center transition-all ';
            if (isDisabled) {
              style = 'border-radius:4px;color:rgba(138,128,112,0.3);cursor:not-allowed;';
              cls += '';
            } else if (isSelected) {
              style = 'border-radius:4px;background:var(--gold);color:var(--dark);font-weight:700;cursor:pointer;';
            } else {
              style = 'border-radius:4px;color:var(--muted);cursor:pointer;';
              cls += 'hover:bg-zinc-800 hover:text-mcv-cream';
            }
            html += `<button type="button" class="${cls}" style="${style}" data-date="${iso}" ${isDisabled ? 'disabled' : ''}>${d}</button>`;
          }
          calGrid.innerHTML = html;
          calPrev.disabled = (viewYear === minDate.getFullYear() && viewMonth === minDate.getMonth());
          calPrev.style.opacity = calPrev.disabled ? '0.3' : '1';
        }
        calGrid.addEventListener('click', function(e) {
          const btn = e.target.closest('button[data-date]');
          if (!btn || btn.disabled) return;
          selectedDate = new Date(btn.dataset.date + 'T00:00:00');
          hiddenDate.value = btn.dataset.date;
          calText.textContent = frStr(selectedDate);
          calLabel.classList.remove('hidden');
          renderHeure(selectedDate.getDay(), selectedDate);
          renderCalendar();
        });
        calPrev.addEventListener('click', () => { viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; } renderCalendar(); });
        calNext.addEventListener('click', () => { viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; } renderCalendar(); });
        renderCalendar();
      })();
      </script>

      {# ─── Adresse de livraison (masqué par défaut) ─── #}
      <div id="section-livraison" class="hidden" style="border-radius:2px;background:var(--dark2);border:1px solid var(--borderl);padding:1.5rem;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;letter-spacing:.12em;color:var(--cream);margin-bottom:.5rem;font-weight:400;">ADRESSE DE LIVRAISON</h2>
        <p style="font-size:.75rem;color:var(--muted);margin-bottom:1.25rem;font-family:'DM Sans',sans-serif;line-height:1.6;">
{% set liv = site.livraison.modes["livraison"] %}
          📦 Expédition {{ liv.transporteur }}, livraison en {{ liv.delai }}.<br/>
          Livraison offerte dès {{ liv.seuilGratuit | eur }} d'achat, sinon {{ liv.fraisPort | eur }}.
        </p>
        <div class="space-y-4">
          <label class="block">
            <span style="display:block;font-size:.8rem;color:var(--cream);margin-bottom:.5rem;font-family:'DM Sans',sans-serif;">Adresse *</span>
            <input type="text" name="livraisonAdresse" maxlength="150" placeholder="12 rue de la Paix, Appt 3"
