---
layout: layouts/base.njk
permalink: /admin/stocks/index.html
title: "Gestion des stocks"
description: "Back-office MaisonCBDVape"
eleventyExcludeFromCollections: true
---
{% set adminSection = "stocks" %}
<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

  {% include "partials/admin-nav.njk" %}

  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
    <div>
      <p class="font-mono text-xs text-smoke uppercase tracking-widest mb-1">Back-office</p>
      <h1 class="font-display text-4xl lg:text-5xl text-white tracking-wide">STOCKS</h1>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/admin/reception/" class="btn-outline-violet px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider">Réceptionner une livraison</a>
    </div>
  </div>

  <div id="stocks-status" class="rounded-2xl border border-dashed border-dark-border bg-dark-card/40 py-20 text-center">
    <p class="text-smoke text-sm">Chargement…</p>
  </div>

  <div id="stocks-panel" class="hidden">
    <div class="grid grid-cols-3 gap-3 mb-6" id="stocks-kpi"></div>

    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <input type="search" id="stocks-filtre" placeholder="Rechercher une référence…"
             class="flex-1 min-w-[200px] bg-dark-bg border border-dark-border rounded-xl px-4 py-2.5 text-white text-sm placeholder-smoke focus:outline-none"/>
      <button id="stocks-ruptures" class="filter-pill px-3 py-2 rounded-lg text-xs font-mono uppercase tracking-wider">Ruptures seules</button>
      <button id="stocks-poids" class="filter-pill px-3 py-2 rounded-lg text-xs font-mono uppercase tracking-wider">Vrac au gramme</button>
    </div>

    <div class="rounded-2xl border border-dark-border bg-dark-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-smoke text-xs font-mono uppercase tracking-wider border-b border-dark-border">
              <th class="text-left py-3 px-4">Référence</th>
              <th class="text-right py-3 px-4">Disponible</th>
              <th class="text-right py-3 px-4">Réservé</th>
              <th class="text-right py-3 px-4">Ajuster</th>
            </tr>
          </thead>
          <tbody id="stocks-tbody"></tbody>
        </table>
      </div>
    </div>

    {# Ce que les clients réclament — n'apparaît que s'il y a des inscrits. #}
    <div id="stocks-attentes" class="mt-10" hidden>
      <h2 class="font-display text-2xl text-white tracking-wide mb-1">CE QU'ON VOUS RÉCLAME</h2>
      <p class="text-smoke text-xs mb-4">
        Clients inscrits au retour en stock. Ils seront prévenus automatiquement
        à la réception de la marchandise — ou dès que vous remonterez la quantité ici.
      </p>
      <div id="stocks-attentes-liste" class="rounded-2xl border border-dark-border bg-dark-card overflow-hidden"></div>
    </div>

    {# Réservé à la barre d'enregistrement, qui est fixée en bas de l'écran :
       sans cette réserve, elle masquerait les dernières lignes du tableau. #}
    <div id="stocks-reserve" class="hidden" style="height:5.5rem;"></div>
  </div>
</section>

{# Barre d'enregistrement — n'apparaît qu'en cas de saisie en attente. #}
<div id="stocks-barre" class="barre-enregistrer" hidden>
  <div class="barre-enregistrer-contenu">
    <p id="stocks-compte" class="text-sm text-white"></p>
    <div class="flex items-center gap-3">
      <button id="stocks-annuler" class="btn-outline-violet px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider">Annuler</button>
      <button id="stocks-enregistrer" class="btn-gold px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest">Tout enregistrer</button>
    </div>
  </div>
  <p id="stocks-erreur" class="barre-enregistrer-erreur" hidden></p>
</div>

<script>
(function () {
  // Jeton fourni par la barre d'admin : elle accepte aussi celui de l'éditeur
  // de contenu, ce qui évite une seconde connexion. Voir partials/admin-nav.njk.
  let token = window.MCV_ADMIN.token();

  const statusEl = document.getElementById('stocks-status');
  const panel    = document.getElementById('stocks-panel');
  const tbody    = document.getElementById('stocks-tbody');
  const kpi      = document.getElementById('stocks-kpi');
  const filtre   = document.getElementById('stocks-filtre');
  const btnRupt  = document.getElementById('stocks-ruptures');
  const barre    = document.getElementById('stocks-barre');
  const reserve  = document.getElementById('stocks-reserve');
  const compte   = document.getElementById('stocks-compte');
  const erreurEl = document.getElementById('stocks-erreur');

  let stocks = [], ruptureSeules = false, poidsSeuls = false;

  /**
   * Saisies en attente d'enregistrement — clé → quantité voulue.
   *
   * Elle vit en dehors du tableau parce que le tableau se reconstruit à
   * chaque frappe dans le filtre. Une valeur tapée puis masquée par une
   * recherche doit se retrouver telle quelle quand la recherche est effacée,
   * sans quoi l'inventaire se perdrait par petits bouts.
   *
   * Une valeur ramenée à sa quantité d'origine en sort : ce n'est plus une
   * modification, et la compter en ferait tracer une de zéro.
   */
  const enAttente = new Map();

  /**
   * Les fleurs CBD sont pesées à la commande depuis un vrac : leur stock se
   * compte en grammes, pas en sachets. Un sachet de 4 g en retire 4.
   */
  function unite(s) { return s.unite === 'g' ? 'g' : null; }
  function quantite(s, n) { const u = unite(s); return u ? `${n} ${u}` : String(n); }

  function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#x27;');
  }

  function showLogin() {
    panel.classList.add('hidden');
    statusEl.innerHTML = `
      <p class="text-smoke text-sm mb-4">Connexion requise.</p>
      <a href="/api/auth/login?mode=admin&return=/admin/stocks/" class="btn-neon-green inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-widest">Se connecter via GitHub</a>`;
    statusEl.classList.remove('hidden');
  }

  // Le seuil vient du serveur, ligne par ligne : il dépend de l'unité. Trois
  // grammes de fleur, ce n'est pas un stock faible, c'est un stock fini —
  // l'alerte doit se déclencher bien avant, vers 30 g.
  function couleur(s) {
    if (s.dispo <= 0) return '#FF5050';
    if (s.faible)     return '#FFA500';
    return 'var(--green)';
  }

  /** Sépare « produit-id::4g » en produit et variante. */
  function decoupe(s) {
    const i = s.cle.indexOf('::');
    if (i === -1) return { produit: s.cle, variante: null, nom: s.libelle || s.cle };
    return {
      produit: s.cle.slice(0, i),
      variante: s.cle.slice(i + 2),
      // Le libellé semé vaut « Nom — 4g » : on retire le suffixe pour l'affichage
      nom: (s.libelle || '').split(' — ')[0] || s.cle.slice(0, i),
    };
  }

  function render() {
    const q = (filtre.value || '').trim().toLowerCase();
    const vue = stocks.filter((s) =>
      (!ruptureSeules || s.dispo <= 0) &&
      (!poidsSeuls || unite(s) === 'g') &&
      (!q || s.libelle.toLowerCase().includes(q) || s.cle.toLowerCase().includes(q))
    );

    let html = '', produitPrecedent = null;

    for (const s of vue) {
      const d = decoupe(s);
      // Nouvelle ligne d'en-tête dès qu'on change de produit à variantes
      const nouveauProduit = d.produit !== produitPrecedent;
      produitPrecedent = d.produit;

      const libelle = d.variante
        ? `${nouveauProduit ? `<div class="text-white">${esc(d.nom)}</div>` : ''}
           <div class="flex items-center gap-2 ${nouveauProduit ? 'mt-1' : ''}">
             <span class="text-smoke text-xs">↳</span>
             <span class="text-xs font-mono px-2 py-0.5 rounded-full"
                   style="border:1px solid var(--gold);color:var(--gold);">${esc(d.variante)}</span>
           </div>`
        : `<div class="text-white">${esc(d.nom)}</div>
           <div class="text-smoke text-xs font-mono">${esc(s.cle)}${
             unite(s) ? ' · <span style="color:var(--gold);">vrac au gramme</span>' : ''}</div>`;

      // La valeur affichée est celle en cours de saisie s'il y en a une : le
      // tableau se redessine à chaque filtre, et une saisie effacée par un
      // changement de filtre serait perdue sans que rien ne le signale.
      const enCours = enAttente.has(s.cle);
      const valeur  = enCours ? enAttente.get(s.cle) : s.dispo;

      html += `
        <tr class="border-b border-dark-border last:border-0${enCours ? ' ligne-modifiee' : ''}"
            ${d.variante && !nouveauProduit ? 'style="border-top:0;"' : ''}>
          <td class="py-3 px-4">${libelle}</td>
          <td class="py-3 px-4 text-right font-mono font-bold" style="color:${couleur(s)};">${quantite(s, s.dispo)}</td>
          <td class="py-3 px-4 text-right font-mono text-smoke">${quantite(s, s.reserve || 0)}</td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center gap-2 justify-end">
              <input type="number" min="0" step="1" value="${valeur}" data-cle="${esc(s.cle)}"
                     aria-label="Stock disponible${unite(s) ? ' en grammes' : ''}"
                     class="champ-stock w-20 bg-dark-bg border border-dark-border rounded-lg px-2 py-1.5 text-white text-sm text-right focus:outline-none"/>
              ${unite(s) ? '<span class="text-smoke text-xs font-mono w-3">g</span>' : '<span class="w-3"></span>'}
            </div>
          </td>
        </tr>`;
    }

    tbody.innerHTML = html ||
      `<tr><td colspan="4" class="py-10 text-center text-smoke text-sm">Aucune référence.</td></tr>`;
  }

  function renderKpi(d) {
    const carte = (label, val, col) => `
      <div class="rounded-xl bg-dark-card border border-dark-border p-4">
        <p class="text-smoke text-xs uppercase tracking-wider font-mono mb-1">${label}</p>
        <p class="font-display text-3xl" style="color:${col};">${val}</p>
      </div>`;
    kpi.innerHTML = carte('Références', d.total, 'var(--cream)')
                  + carte('Stock faible', d.faibles, '#FFA500')
                  + carte('Ruptures', d.ruptures, '#FF5050');
  }

  /**
   * Ce que les clients réclament.
   *
   * Le bloc reste caché tant que personne n'attend : une section vide sur un
   * tableau de bord fait douter de sa fiabilité plus qu'elle n'informe.
   */
  function renderAttentes(liste) {
    const bloc = document.getElementById('stocks-attentes');
    if (!liste.length) { bloc.hidden = true; return; }

    document.getElementById('stocks-attentes-liste').innerHTML = liste.map((a) => `
      <div class="flex items-center justify-between gap-4 px-4 py-3 border-b border-dark-border last:border-0">
        <div class="min-w-0">
          <div class="text-white text-sm truncate">${esc(a.nom)}</div>
          <div class="text-smoke text-xs font-mono truncate">${esc(a.cle)}</div>
        </div>
        <div class="text-right shrink-0">
          <div class="font-mono font-bold text-lg" style="color:var(--gold);">${a.attendus}</div>
          <div class="text-smoke text-xs">${a.attendus > 1 ? 'clients' : 'client'}</div>
        </div>
      </div>`).join('');
    bloc.hidden = false;
  }

  async function charger() {
    if (!token) return showLogin();
    try {
      const res = await fetch('/api/stocks', { headers: { Authorization: 'Bearer ' + token } });
      if (res.status === 401 || res.status === 403) { window.MCV_ADMIN.oublier(); return showLogin(); }
      const d = await res.json();
      if (!res.ok) throw new Error(d.error || 'HTTP ' + res.status);

      // Tri par produit puis par variante, pour que les grammages d'une même
      // fleur se suivent dans l'ordre plutôt que dans l'ordre alphabétique
      // (« 2g, 4g, 8g » et non « 2g, 8g, 4g »).
      stocks = (d.stocks || []).sort((a, b) => {
        const da = decoupe(a), db_ = decoupe(b);
        if (da.nom !== db_.nom) return da.nom.localeCompare(db_.nom, 'fr');
        const na = parseInt(da.variante, 10), nb = parseInt(db_.variante, 10);
        if (Number.isFinite(na) && Number.isFinite(nb)) return na - nb;
        return String(da.variante || '').localeCompare(String(db_.variante || ''), 'fr');
      });
      renderKpi(d);
      renderAttentes(d.attentes || []);
      render();
      statusEl.classList.add('hidden');
      panel.classList.remove('hidden');
    } catch (e) {
      statusEl.innerHTML = `<p class="text-red-300 text-sm">${esc(e.message)}</p>`;
      statusEl.classList.remove('hidden');
    }
  }

  // ─── Saisie groupée ───────────────────────────────────────────────────────

  /** Reflète l'état de `enAttente` dans la barre du bas. */
  function majBarre() {
    const n = enAttente.size;
    reserve.classList.toggle('hidden', n === 0);
    barre.hidden = n === 0;
    if (!n) return;
    compte.textContent = n === 1
      ? '1 référence modifiée, pas encore enregistrée'
      : `${n} références modifiées, pas encore enregistrées`;
  }

  function erreur(message) {
    erreurEl.textContent = message || '';
    erreurEl.hidden = !message;
  }

  // Une saisie n'écrit rien tant qu'elle n'est pas enregistrée : on se
  // contente de la retenir. `change` plutôt que `input` laisserait passer une
  // valeur tapée puis validée par la touche Entrée sans quitter le champ.
  tbody.addEventListener('input', (e) => {
    const champ = e.target.closest('input[data-cle]');
    if (!champ) return;
    const cle = champ.dataset.cle;
    const ligne = stocks.find((s) => s.cle === cle);
    if (!ligne) return;

    const val = parseInt(champ.value, 10);
    if (!Number.isInteger(val) || val < 0) return;   // saisie en cours, on attend

    if (val === ligne.dispo) enAttente.delete(cle);
    else enAttente.set(cle, val);

    champ.closest('tr').classList.toggle('ligne-modifiee', enAttente.has(cle));
    erreur('');
    majBarre();
  });

  document.getElementById('stocks-annuler').addEventListener('click', () => {
    if (!enAttente.size) return;
    if (!confirm(`Abandonner les ${enAttente.size} modification(s) non enregistrées ?`)) return;
    enAttente.clear();
    erreur('');
    majBarre();
    render();
  });

  document.getElementById('stocks-enregistrer').addEventListener('click', async (e) => {
    if (!enAttente.size) return;
    const btn = e.currentTarget;
    const ajustements = [...enAttente].map(([cle, dispo]) => ({ cle, dispo }));

    btn.disabled = true;
    const libelleBtn = btn.textContent;
    btn.textContent = 'Enregistrement…';
    erreur('');
    try {
      const res = await fetch('/api/stocks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ ajustements }),
      });
      const d = await res.json();

      // 409 : une référence a disparu du catalogue depuis l'ouverture de la
      // page. Rien n'a été écrit — on le dit, et on garde la saisie intacte
      // pour que le travail ne soit pas perdu.
      if (res.status === 409) throw new Error(d.error);
      if (!res.ok) throw new Error(d.error || 'HTTP ' + res.status);

      enAttente.clear();
      majBarre();
      await charger();            // relit l'inventaire plutôt que de le deviner
    } catch (err) {
      erreur(err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = libelleBtn;
    }
  });

  // Dernier garde-fou : un inventaire saisi puis perdu par une fermeture
  // d'onglet représente une heure de travail.
  window.addEventListener('beforeunload', (e) => {
    if (!enAttente.size) return;
    e.preventDefault();
    e.returnValue = '';
  });

  filtre.addEventListener('input', render);
  document.getElementById('stocks-poids').addEventListener('click', (e) => {
    poidsSeuls = !poidsSeuls;
    e.currentTarget.classList.toggle('is-active', poidsSeuls);
    render();
  });
  btnRupt.addEventListener('click', () => {
    ruptureSeules = !ruptureSeules;
    btnRupt.classList.toggle('is-active', ruptureSeules);
    render();
  });

  charger();
})();
</script>
