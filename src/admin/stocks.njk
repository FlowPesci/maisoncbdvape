---
layout: layouts/base.njk
permalink: /admin/stocks/index.html
title: "Gestion des stocks"
description: "Back-office MaisonCBDVape"
eleventyExcludeFromCollections: true
---
{% set adminSection = "stocks" %}
<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

  {% include "partials/admin-nav.njk" %}

  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
    <div>
      <p class="font-mono text-xs text-smoke uppercase tracking-widest mb-1">Back-office</p>
      <h1 class="font-display text-4xl lg:text-5xl text-white tracking-wide">STOCKS</h1>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/admin/reception/" class="btn-outline-violet px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider">Réceptionner une livraison</a>
    </div>
  </div>

  <div id="stocks-status" class="rounded-2xl border border-dashed border-dark-border bg-dark-card/40 py-20 text-center">
    <p class="text-smoke text-sm">Chargement…</p>
  </div>

  <div id="stocks-panel" class="hidden">
    <div class="grid grid-cols-3 gap-3 mb-6" id="stocks-kpi"></div>

    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <input type="search" id="stocks-filtre" placeholder="Rechercher une référence…"
             class="flex-1 min-w-[200px] bg-dark-bg border border-dark-border rounded-xl px-4 py-2.5 text-white text-sm placeholder-smoke focus:outline-none"/>
      <button id="stocks-ruptures" class="filter-pill px-3 py-2 rounded-lg text-xs font-mono uppercase tracking-wider">Ruptures seules</button>
      <button id="stocks-poids" class="filter-pill px-3 py-2 rounded-lg text-xs font-mono uppercase tracking-wider">Vrac au gramme</button>
    </div>

    <div class="rounded-2xl border border-dark-border bg-dark-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-smoke text-xs font-mono uppercase tracking-wider border-b border-dark-border">
              <th class="text-left py-3 px-4">Référence</th>
              <th class="text-right py-3 px-4">Disponible</th>
              <th class="text-right py-3 px-4">Réservé</th>
              <th class="text-right py-3 px-4">Ajuster</th>
            </tr>
          </thead>
          <tbody id="stocks-tbody"></tbody>
        </table>
      </div>
    </div>

    {# Ce que les clients réclament — n'apparaît que s'il y a des inscrits. #}
    <div id="stocks-attentes" class="mt-10" hidden>
      <h2 class="font-display text-2xl text-white tracking-wide mb-1">CE QU'ON VOUS RÉCLAME</h2>
      <p class="text-smoke text-xs mb-4">
        Clients inscrits au retour en stock. Ils seront prévenus automatiquement
        à la réception de la marchandise — ou dès que vous remonterez la quantité ici.
      </p>
      <div id="stocks-attentes-liste" class="rounded-2xl border border-dark-border bg-dark-card overflow-hidden"></div>
    </div>

    {# Réservé à la barre d'enregistrement, qui est fixée en bas de l'écran :
       sans cette réserve, elle masquerait les dernières lignes du tableau. #}
    <div id="stocks-reserve" class="hidden" style="height:5.5rem;"></div>
  </div>
</section>

{# Barre d'enregistrement — n'apparaît qu'en cas de saisie en attente. #}
<div id="stocks-barre" class="barre-enregistrer" hidden>
  <div class="barre-enregistrer-contenu">
    <p id="stocks-compte" class="text-sm text-white"></p>
    <div class="flex items-center gap-3">
      <button id="stocks-annuler" class="btn-outline-violet px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider">Annuler</button>
      <button id="stocks-enregistrer" class="btn-gold px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest">Tout enregistrer</button>
    </div>
  </div>
  <p id="stocks-erreur" class="barre-enregistrer-erreur" hidden></p>
</div>

<script src="/assets/js/admin-stocks.js?v={{ '/assets/js/admin-stocks.js' | contentHash }}" defer></script>
