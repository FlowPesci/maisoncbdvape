---
layout: layouts/base.njk
permalink: /admin/reception/index.html
title: "Réception de marchandise"
description: "Back-office MaisonCBDVape"
eleventyExcludeFromCollections: true
---
{% set adminSection = "reception" %}
<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

  {% include "partials/admin-nav.njk" %}

  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
    <div>
      <p class="font-mono text-xs text-smoke uppercase tracking-widest mb-1">Back-office</p>
      <h1 class="font-display text-4xl lg:text-5xl text-white tracking-wide">RÉCEPTION</h1>
    </div>
  </div>

  <div id="rec-status" class="rounded-2xl border border-dashed border-dark-border bg-dark-card/40 py-20 text-center">
    <p class="text-smoke text-sm">Chargement…</p>
  </div>

  <div id="rec-panel" class="hidden">

    {# Dépôt du document #}
    <label id="rec-drop" for="rec-fichier"
           class="block rounded-2xl border-2 border-dashed border-dark-border bg-dark-card/40 px-6 py-10 text-center cursor-pointer transition-colors mb-6">
      <svg class="w-8 h-8 mx-auto mb-3" style="color:var(--gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"/>
      </svg>
      <p class="text-white text-sm font-semibold mb-1">Déposer le bon de livraison</p>
      <p class="text-smoke text-xs">PDF ou photo — glisser ici, ou cliquer pour choisir</p>
      <input type="file" id="rec-fichier" accept="application/pdf,image/*" class="hidden"/>
    </label>

    <div id="rec-lecture" class="hidden rounded-xl border border-dark-border bg-dark-card px-4 py-3 mb-6 text-sm text-smoke"></div>

    {# Lignes à valider #}
    <div id="rec-travail" class="hidden">

      <div class="grid sm:grid-cols-2 gap-3 mb-4">
        <div>
          <label class="block text-smoke text-xs font-mono uppercase tracking-wider mb-1">Fournisseur</label>
          <input id="rec-fournisseur" type="text" placeholder="optionnel"
                 class="w-full bg-dark-bg border border-dark-border rounded-xl px-4 py-2.5 text-white text-sm placeholder-smoke focus:outline-none"/>
        </div>
        <div>
          <label class="block text-smoke text-xs font-mono uppercase tracking-wider mb-1">N° du bon</label>
          <input id="rec-reference" type="text" placeholder="optionnel"
                 class="w-full bg-dark-bg border border-dark-border rounded-xl px-4 py-2.5 text-white text-sm placeholder-smoke focus:outline-none"/>
        </div>
      </div>

      <div id="rec-resume" class="flex items-center gap-2 flex-wrap mb-4"></div>

      <div id="rec-lignes" class="space-y-3"></div>

      <div class="flex items-center gap-3 flex-wrap mt-5">
        <button id="rec-ajouter" class="btn-outline-violet px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider">+ Ajouter une ligne</button>
        <div class="flex-1"></div>
        <button id="rec-valider" class="btn-gold px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-widest">Valider la réception</button>
      </div>

      <p id="rec-erreur" class="hidden text-red-300 text-sm mt-3"></p>
    </div>

    {# Historique #}
    <div id="rec-historique" class="mt-10"></div>
  </div>
</section>

<datalist id="rec-catalogue"></datalist>

<script src="/assets/js/admin-reception.js?v={{ '/assets/js/admin-reception.js' | contentHash }}" defer></script>
